# pnpm configuration for Lateralzr monorepo

# Hoist packages needed by Metro bundler during Expo web builds.
# Metro requires direct access to many transitive dependencies that pnpm
# would normally place in nested node_modules folders.
public-hoist-pattern[]=*react-navigation*
public-hoist-pattern[]=*react-native*
public-hoist-pattern[]=*expo*
public-hoist-pattern[]=use-latest-callback
public-hoist-pattern[]=fast-deep-equal
public-hoist-pattern[]=escape-string-regexp
public-hoist-pattern[]=nanoid
