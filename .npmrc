# pnpm configuration for Lateralzr monorepo

# Hoist @react-navigation packages and their dependencies to avoid resolution issues
# during Expo web builds. Metro bundler needs these packages accessible at the root.
public-hoist-pattern[]=*react-navigation*
public-hoist-pattern[]=use-latest-callback
public-hoist-pattern[]=fast-deep-equal
public-hoist-pattern[]=escape-string-regexp
public-hoist-pattern[]=nanoid
