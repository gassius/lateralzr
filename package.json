{
  "$schema": "https://www.schemastore.org/package.json",
  "name": "admin",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "vite build",
    "dev": "vite",
    "build:all": "turbo run build",
    "dev:all": "turbo run dev",
