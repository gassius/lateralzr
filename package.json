    "dev:client": "turbo run dev --filter=client"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "axios": "^1.11.0",
    "concurrently": "^9.0.1",
    "laravel-vite-plugin": "^2.0.0",
    "tailwindcss": "^4.0.0",
    "turbo": "^2.3.0",
    "vite": "^7.0.7"
  },
  "packageManager": "pnpm@9.15.0"
}
