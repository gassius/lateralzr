# Base URL of the Lateralzr API (no trailing slash).
# Simulator / web: http://localhost is fine.
# Physical device + Expo Go: leave unset or use localhost — the app infers your Mac's
# LAN IP from Metro (see lib/apiBaseUrl.ts). Or set explicitly, e.g.:
# EXPO_PUBLIC_API_URL=http://192.168.1.10
# Same Wi‑Fi as your computer; ensure the host firewall allows the Sail port (often 80).
EXPO_PUBLIC_API_URL=http://localhost
