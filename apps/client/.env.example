# Base URL of the Lateralzr API (no trailing slash).
#
# Local development (Simulator / Expo Go / web dev server):
#   http://localhost is fine (or leave unset).
#   Physical device + Expo Go: the app infers your Mac's LAN IP from Metro (see lib/apiBaseUrl.ts).
#   Or set explicitly, e.g.: http://192.168.1.10
#   Same Wi‑Fi as your computer; ensure the host firewall allows the Sail port (often 80).
#
# Production (Vercel deployment):
#   Set EXPO_PUBLIC_API_URL=https://api.lateralzr.com in Vercel dashboard for Production and Preview environments.
#   This must be configured in Vercel project settings > Environment Variables.
#
EXPO_PUBLIC_API_URL=http://localhost

# Expo MCP local capabilities (SDK 54+): screenshots, tap automation, DevTools, router sitemap.
# Requires the expo-mcp package and an authenticated Expo MCP connection in your AI tool.
# Prefer: pnpm start:mcp
# Or: EXPO_UNSTABLE_MCP_SERVER=1 pnpm start
# Docs: https://docs.expo.dev/mcp.md
