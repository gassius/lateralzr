{
  "expo": {
    "name": "Lateralzr",
    "slug": "client",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/logo/lateralzr-ios-app-icon-1024.png",
    "scheme": "client",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSAppTransportSecurity": {
          "NSAllowsLocalNetworking": true
        }
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/logo/lateralzr-android-adaptive-foreground-1024.png",
        "backgroundColor": "#F78D1E"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/logo/lateralzr-favicon@2x.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true
          }
        }
      ],
      "expo-image",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/logo/lateralzr-logo-on-orange@3x.png",
          "resizeMode": "contain",
          "backgroundColor": "#F78D1E"
        }
      ],
      "expo-status-bar"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
