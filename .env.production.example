# Production Environment Variables
# Copy this to .env on the server at /home/cgonzalez/lateralzr/.env

APP_NAME=Lateralzr
APP_ENV=production
APP_KEY=                              # Generate with: php artisan key:generate
APP_DEBUG=false
APP_URL=https://api.lateralzr.com

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

# Database - connects to shared MySQL on gonzalezrico_platform network
DB_CONNECTION=mysql
DB_HOST=mysql_db_1                    # Shared MySQL container name
DB_PORT=3306
DB_DATABASE=lateralzr                 # Database name (already exists)
DB_USERNAME=lateralzr                 # Username (already exists)
DB_PASSWORD=                          # Set from server credentials

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=.lateralzr.com

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@lateralzr.com"
MAIL_FROM_NAME="${APP_NAME}"

# CORS Configuration
# Comma-separated list of allowed origins for API requests from browser clients
# Production: allow Vercel preview domains and production domain for Expo web client
CORS_ALLOWED_ORIGINS="https://lateralzr.com,https://*.vercel.app"

# Laravel AI SDK - Ollama Configuration
# For production, consider using a remote LLM service
OLLAMA_API_KEY=
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=llama3.2:3b

# Concept naming complexity (1-5)
CONCEPTS_DEFAULT_COMPLEXITY=2
AI_DEFAULT_PROVIDER=ollama

# Vite (for admin panel assets)
VITE_APP_NAME="${APP_NAME}"
