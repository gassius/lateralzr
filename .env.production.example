# Production Environment Variables
# Copy this to .env on the server at /home/cgonzalez/lateralzr/.env

APP_NAME=Lateralzr
APP_ENV=production
APP_KEY=                              # Generate with: php artisan key:generate
APP_DEBUG=false
APP_URL=https://api.lateralzr.com

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single,stderr
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

# Database - connects to shared MySQL on gonzalezrico_platform network
DB_CONNECTION=mysql
DB_HOST=mysql_db_1                    # Shared MySQL container name
DB_PORT=3306
DB_DATABASE=lateralzr                 # Database name (already exists)
DB_USERNAME=lateralzr                 # Username (already exists)
DB_PASSWORD=                          # Set from server credentials

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=.lateralzr.com

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@lateralzr.com"
MAIL_FROM_NAME="${APP_NAME}"

# CORS Configuration
# Comma-separated list of allowed origins for API requests from browser clients
# Production: allow Vercel preview domains and production domain for Expo web client
CORS_ALLOWED_ORIGINS="https://lateralzr.com,https://*.vercel.app"

# Laravel AI SDK — production uses OpenRouter via laravel/ai (driver + key).
# After changing these, rebuild/restart queue so workers pick up env, then:
#   ./bin/artisan config:cache
#   docker compose -f docker-compose.prod.yml restart queue
#   ./bin/artisan ai:ping --provider=openrouter --dry-run
#   ./bin/artisan ai:ping --provider=openrouter
AI_DEFAULT_PROVIDER=openrouter
OPENROUTER_API_KEY=                          # Required. Create at https://openrouter.ai/keys
OPENROUTER_DEFAULT_MODEL=openai/gpt-4o-mini  # Must be a real OpenRouter model id
# Do not set OPENROUTER_BASE_URL. laravel/ai 0.1 + Prism already use
# https://openrouter.ai/api/v1 (not .../chat/completions).
#
# Known-good examples: openai/gpt-4o-mini, anthropic/claude-sonnet-4.5
# Invalid example (historical prod 404): deepseek/deepseek-v4-flash-0731
# Leave OPENROUTER_DEFAULT_MODEL empty to fall back to openai/gpt-4o-mini.
#
# Local Ollama remains available if you temporarily switch providers:
# AI_DEFAULT_PROVIDER=ollama
OLLAMA_API_KEY=
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=llama3.2:3b

# Concept naming complexity (1-5)
CONCEPTS_DEFAULT_COMPLEXITY=2
CONCEPTS_DEFAULT_LOCALE=en
CONCEPTS_SUPPORTED_LOCALES=en,es

# Vite (for admin panel assets)
VITE_APP_NAME="${APP_NAME}"

# Host bind-mount for Laravel storage (uploads, logs, cache, public disk).
# Unset defaults to ./storage (today's VPS path). Set only for the Hetzner
# Volume cutover. bin/deploy-prod reads this the same way Compose does.
# LATERALZR_STORAGE=/mnt/data/lateralzr/storage
