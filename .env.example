APP_NAME=Lateralzr
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single,stderr
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# CORS Configuration
# Comma-separated list of allowed origins for API requests from browser clients
# Local development: include localhost and LAN IPs for Expo web dev server
# Production: include Vercel preview domains and production domain
CORS_ALLOWED_ORIGINS="http://localhost:8081,http://localhost:19006,https://lateralzr.com,https://*.vercel.app"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Laravel AI SDK Configuration
# Local Sail/Docker: ollama. Production VPS: openrouter (see .env.production.example).
AI_DEFAULT_PROVIDER=ollama
OLLAMA_API_KEY=
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=llama3.2:3b

# OpenRouter (used when AI_DEFAULT_PROVIDER=openrouter, e.g. production)
# laravel/ai v0.1 ships the OpenRouter driver (driver + key only). Prism uses
# https://openrouter.ai/api/v1 as the base URL — do not set a /chat/completions path.
# OPENROUTER_API_KEY=your_key_here
# OPENROUTER_DEFAULT_MODEL=openai/gpt-4o-mini
# Use a real model id from https://openrouter.ai/models. Invented slugs (e.g.
# deepseek/deepseek-v4-flash-0731) return HTTP 404. Leave the model unset to
# fall back to openai/gpt-4o-mini.

# Concept naming complexity for POST /api/concepts/relationships (1=simple … 5=dense); overridable per request
CONCEPTS_DEFAULT_COMPLEXITY=2
# Concept term locales (API `locale` param; Filament terms; concepts:localize)
CONCEPTS_DEFAULT_LOCALE=en
CONCEPTS_SUPPORTED_LOCALES=en,es
