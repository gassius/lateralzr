#!/usr/bin/env bash

# Print the app service bind-mount source for /var/www/html/storage from
# docker-compose.prod.yml (or a compose file passed as $1).
#
# Used by the GitHub Actions verify step so multiline Python never sits in
# workflow YAML (column-0 lines end a block scalar and invalidate the file).
# Never fails the caller: missing tools, compose errors, or a missing bind
# produce empty stdout and exit 0.

set -u

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PROJECT_ROOT="$(cd "$SCRIPT_DIR/.." && pwd)"
COMPOSE_FILE="${1:-docker-compose.prod.yml}"

cd "$PROJECT_ROOT" || exit 0

if ! command -v docker >/dev/null 2>&1; then
    exit 0
fi

if ! command -v python3 >/dev/null 2>&1; then
    exit 0
fi

docker compose -f "$COMPOSE_FILE" config --format json 2>/dev/null | python3 -c '
import json, sys
try:
    data = json.load(sys.stdin)
except Exception:
    raise SystemExit(0)
for volume in data.get("services", {}).get("app", {}).get("volumes", []):
    if isinstance(volume, dict) and volume.get("target") == "/var/www/html/storage":
        print(volume.get("source", "") or "")
        break
' || true

exit 0
