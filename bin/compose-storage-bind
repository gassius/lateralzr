#!/usr/bin/env bash

# Print the app service bind-mount source for /var/www/html/storage from
# docker-compose.prod.yml (or a compose file passed as $1).
#
# Used by the GitHub Actions verify step so multiline Python never sits in
# workflow YAML (column-0 lines end a block scalar and invalidate the file).
# Never fails the caller: missing tools, compose errors, or a missing bind
# produce empty stdout and exit 0. Compose / tool errors go to stderr.
# The parser (compose-storage-bind.py) must stay Python 3.6-compatible.

set -u

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PROJECT_ROOT="$(cd "$SCRIPT_DIR/.." && pwd)"
COMPOSE_FILE="${1:-docker-compose.prod.yml}"

cd "$PROJECT_ROOT" || exit 0

if ! command -v docker >/dev/null 2>&1; then
    echo "compose-storage-bind: docker not found" >&2
    exit 0
fi

if ! command -v python3 >/dev/null 2>&1; then
    echo "compose-storage-bind: python3 not found" >&2
    exit 0
fi

PARSER="$SCRIPT_DIR/compose-storage-bind.py"
if [[ ! -f "$PARSER" ]]; then
    echo "compose-storage-bind: $PARSER not found" >&2
    exit 0
fi

docker compose -f "$COMPOSE_FILE" config --format json | python3 "$PARSER" || true

exit 0
