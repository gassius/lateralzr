#!/usr/bin/env bash

set -euo pipefail

# Conservative Docker disk cleanup for the Lateralzr VPS.
# Safe defaults: build cache + dangling images only.
# Does NOT prune volumes (shared gonzalezrico MySQL/Traefik data may live there).
# Invoked automatically by bin/deploy-prod before the disk preflight and after
# a successful compose up (fail-soft if this script is missing).

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PROJECT_ROOT="$(cd "$SCRIPT_DIR/.." && pwd)"

cd "$PROJECT_ROOT"

echo "🧹 Lateralzr Docker disk cleanup (conservative)"
echo "==============================================="
echo "Working directory: $(pwd)"
echo ""

echo "📊 Docker disk usage (before):"
docker system df || true
echo ""

echo "💾 Host filesystem:"
df -h "$PROJECT_ROOT" "${DOCKER_ROOT:-/var/lib/docker}" 2>/dev/null | sed 's/^/   /' || df -h "$PROJECT_ROOT" | sed 's/^/   /'
echo ""

echo "🔧 Pruning build cache (docker builder prune)..."
docker builder prune -f

echo ""
echo "🔧 Pruning dangling images only (docker image prune)..."
docker image prune -f

echo ""
echo "📊 Docker disk usage (after):"
docker system df || true
echo ""
echo "✅ Cleanup complete."
echo ""
echo "Not run by this script (higher risk on a shared VPS):"
echo "  - docker volume prune   — can remove unused named volumes (MySQL, etc.)"
echo "  - docker system prune -a — removes all unused images; next deploy rebuilds everything"
echo ""
echo "Laravel logs on disk (bind mount): rotate or truncate storage/logs/*.log if large."
echo "Inspect: du -sh storage/logs .git docker/ 2>/dev/null; du -sh /var/lib/docker 2>/dev/null"
