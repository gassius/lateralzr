#!/usr/bin/env bash
# Build lateralzr_app:prod from docker-compose.prod.yml (app service only).
# Shared by bin/deploy-prod and deploy-prod.sh.
#
# Exit codes:
#   0   success (image verified present)
#   1   build failed or image missing after success exit
#   130 interrupted (SIGINT) — may still leave a usable image
#   143 interrupted (SIGTERM)

set -euo pipefail

COMPOSE_FILE="${1:-docker-compose.prod.yml}"
IMAGE="${PROD_APP_IMAGE:-lateralzr_app:prod}"
SERVICE="${PROD_BUILD_SERVICE:-app}"

export DOCKER_BUILDKIT=1
export BUILDKIT_PROGRESS="${BUILDKIT_PROGRESS:-plain}"
# Compose v2.37+ defaults to buildx bake. Bake often hangs after a successful
# local image export (layers written / named, CLI never returns). Keep bake off
# for production deploys unless explicitly overridden.
export COMPOSE_BAKE="${COMPOSE_BAKE:-false}"
# Avoid post-export attestation work that can also stall BuildKit clients.
export BUILDX_NO_DEFAULT_ATTESTATIONS="${BUILDX_NO_DEFAULT_ATTESTATIONS:-1}"
export COMPOSE_PARALLEL_LIMIT="${COMPOSE_PARALLEL_LIMIT:-1}"

if [[ ! -f "$COMPOSE_FILE" ]]; then
    echo "❌ Error: $COMPOSE_FILE not found in $(pwd)"
    exit 1
fi

echo "📦 Building Docker image ${IMAGE} (service: ${SERVICE})..."
echo "   COMPOSE_BAKE=${COMPOSE_BAKE} BUILDX_NO_DEFAULT_ATTESTATIONS=${BUILDX_NO_DEFAULT_ATTESTATIONS}"

build_ec=0
# Only the app service has a build stanza; queue/scheduler reuse the tag.
docker compose -f "$COMPOSE_FILE" build --pull --progress=plain "$SERVICE" || build_ec=$?

if [[ "$build_ec" -ne 0 ]]; then
    if [[ "$build_ec" -eq 130 || "$build_ec" -eq 143 ]]; then
        echo ""
        echo "⚠️  Docker build interrupted (exit ${build_ec}) — not treated as a compile failure."
        if docker image inspect "$IMAGE" >/dev/null 2>&1; then
            echo "   Image ${IMAGE} is present on this host."
            echo "   If logs showed exporting/naming DONE, finish deploy without rebuilding:"
            echo "     docker compose -f ${COMPOSE_FILE} run --rm app php artisan migrate --force"
            echo "     docker compose -f ${COMPOSE_FILE} run --rm app php artisan config:cache"
            echo "     docker compose -f ${COMPOSE_FILE} run --rm app php artisan route:cache"
            echo "     docker compose -f ${COMPOSE_FILE} run --rm app php artisan view:cache"
            echo "     docker compose -f ${COMPOSE_FILE} up -d --remove-orphans"
        fi
        exit "$build_ec"
    fi
    echo ""
    echo "❌ Docker build failed (see output above)"
    exit 1
fi

if ! docker image inspect "$IMAGE" >/dev/null 2>&1; then
    echo ""
    echo "❌ Build exited successfully but image ${IMAGE} was not found"
    exit 1
fi

echo "✅ Image ${IMAGE} ready"
