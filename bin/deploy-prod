#!/usr/bin/env bash

set -euo pipefail

# Lateralzr Production Deployment
# Designed to run in /home/cgonzalez/lateralzr ONLY
# Never touches the gonzalezrico compose stack

# New files created here (and by PHP after entrypoint umask) should be 0664.
umask 002

SELF="$(realpath "${BASH_SOURCE[0]}")"
ORIG_ARGS=("$@")

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PROJECT_ROOT="$(cd "$SCRIPT_DIR/.." && pwd)"
COMPOSE_FILE="docker-compose.prod.yml"

cd "$PROJECT_ROOT"

echo "🚀 Lateralzr Production Deployment"
echo "==================================="
echo "Working directory: $(pwd)"
echo ""

if [[ ! -f "$COMPOSE_FILE" ]]; then
    echo "❌ Error: $COMPOSE_FILE not found in $(pwd)"
    exit 1
fi

if [[ ! -f .env ]]; then
    echo "❌ Error: .env file not found"
    echo "   Create .env from .env.production.example and configure it"
    exit 1
fi

APP_KEY_VALUE="$(grep -E '^APP_KEY=' .env | head -n1 | cut -d= -f2- | sed 's/#.*//' | tr -d '[:space:]' | tr -d '"' | tr -d "'")"
if [[ -z "$APP_KEY_VALUE" ]]; then
    echo "❌ Error: APP_KEY is empty in .env"
    echo "   Generate with: docker compose -f $COMPOSE_FILE run --rm app php artisan key:generate --show"
    exit 1
fi

# Keep a pass-1 rewrite across re-exec. Pass 2's ensure is then "unchanged"
# and must not drop --force-recreate.
if [[ "${PROD_LOG_ENV_CHANGED:-0}" == "1" ]]; then
    PROD_LOG_ENV_CHANGED=1
else
    PROD_LOG_ENV_CHANGED=0
fi
if [[ -x "$SCRIPT_DIR/ensure-prod-log-env" ]]; then
    echo "📝 Ensuring LOG_CHANNEL/LOG_STACK resolve to daily..."
    ensure_out="$("$SCRIPT_DIR/ensure-prod-log-env" .env)"
    echo "   ${ensure_out}"
    if [[ "$ensure_out" == "changed" ]]; then
        PROD_LOG_ENV_CHANGED=1
    fi
    echo ""
fi

# Resolve like Compose (shell env, then .env, then ./storage). Do not export
# a defaulted value — that would hide .env from `docker compose`.
if [[ ! -x "$SCRIPT_DIR/storage-host" ]]; then
    echo "❌ Error: bin/storage-host is missing or not executable"
    exit 1
fi
storage_host="$("$SCRIPT_DIR/storage-host" --require-ready)"
if [[ -x "$SCRIPT_DIR/logs-host" ]]; then
    logs_host="$("$SCRIPT_DIR/logs-host")"
else
    logs_host="${storage_host}/logs"
fi

echo "📁 Ensuring host storage directories exist (${storage_host})..."
mkdir -p \
    "${storage_host}/app/public" \
    "${storage_host}/app/private" \
    "${storage_host}/framework/cache/data" \
    "${storage_host}/framework/sessions" \
    "${storage_host}/framework/testing" \
    "${storage_host}/framework/views" \
    "${storage_host}/logs/nginx" \
    "${storage_host}/logs/queue" \
    "${storage_host}/logs/scheduler"
echo ""

echo "📁 Ensuring service log files exist (${logs_host}/{nginx,queue,scheduler})..."
# All under LATERALZR_STORAGE (group-writable www-data). Do not write beside
# storage — the data-dir parent is root:root 755. Ownership is not changed.
touch \
    "${logs_host}/nginx/access.log" \
    "${logs_host}/nginx/error.log" \
    "${logs_host}/queue/queue.log" \
    "${logs_host}/scheduler/scheduler.log"
# Group-writable + setgid so deploy (cgonzalez, in www-data) and container
# www-data can both write. nginx:alpine (uid 101) is re-owned on the
# files after compose up. copytruncate keeps the inode.
chmod 2775 "${logs_host}" "${logs_host}/nginx" "${logs_host}/queue" "${logs_host}/scheduler" || true
# 0664 (umask 002): group-writable, not world-writable. nginx (uid 101)
# is re-owned 101:www-data by the app entrypoint after compose up.
chmod 0664 \
    "${logs_host}/nginx/access.log" \
    "${logs_host}/nginx/error.log" \
    "${logs_host}/queue/queue.log" \
    "${logs_host}/scheduler/scheduler.log" || true
for laravel_log in "${logs_host}"/laravel-*.log; do
    if [[ -f "$laravel_log" ]]; then
        chmod 0664 "$laravel_log" || true
    fi
done
if [[ -x "$SCRIPT_DIR/rotate-prod-logs" ]]; then
    if ! LATERALZR_LOGS_ROOT="${logs_host}" "$SCRIPT_DIR/rotate-prod-logs"; then
        echo "⚠️  rotate-prod-logs failed; continuing deploy" >&2
    fi
fi
echo ""

# Conservative Docker prune (build cache + dangling images only). Fail-soft:
# a missing script or prune error must not abort deploy; disk check is the hard gate.
# Does not prune volumes or Traefik certs.
run_deploy_docker_cleanup() {
    local phase="${1:-}"
    if [[ ! -x "$SCRIPT_DIR/deploy-cleanup-docker" ]]; then
        echo "⚠️  bin/deploy-cleanup-docker missing or not executable; skipping Docker cleanup (${phase})"
        return 0
    fi
    echo "🧹 Running conservative Docker cleanup (${phase})..."
    if ! "$SCRIPT_DIR/deploy-cleanup-docker"; then
        echo "⚠️  Docker cleanup failed (${phase}); continuing (disk check still applies)"
    fi
    echo ""
}

run_deploy_docker_cleanup "before disk check"

# shellcheck source=bin/deploy-disk-check.sh
source "$SCRIPT_DIR/deploy-disk-check.sh"
if ! check_deploy_disk_space "$PROJECT_ROOT"; then
    exit 1
fi
echo ""

echo "🔍 Checking git status..."
if [[ -n $(git status --porcelain) ]]; then
    echo "⚠️  Warning: Working directory has uncommitted changes"
    echo ""
    git status --short
    echo ""
    echo "❌ Refusing to deploy with dirty working tree"
    echo "   Commit or stash changes before deploying"
    exit 1
fi

CURRENT_BRANCH=$(git rev-parse --abbrev-ref HEAD)
echo "📍 Current branch: $CURRENT_BRANCH"

if [[ "${DEPLOY_PROD_REEXEC:-}" != "1" ]]; then
    echo "🔄 Fetching latest from origin..."
    git fetch origin "$CURRENT_BRANCH"

    LOCAL_REV=$(git rev-parse HEAD)
    REMOTE_REV=$(git rev-parse "origin/$CURRENT_BRANCH")

    if [[ "$LOCAL_REV" != "$REMOTE_REV" ]]; then
        echo "⬇️  Pulling latest changes..."
        git pull origin "$CURRENT_BRANCH"
        echo "🔁 Re-executing updated ${SELF}..."
        DEPLOY_PROD_REEXEC=1 PROD_LOG_ENV_CHANGED="$PROD_LOG_ENV_CHANGED" exec "$SELF" "${ORIG_ARGS[@]}"
    else
        echo "✅ Already up to date with origin/$CURRENT_BRANCH"
    fi
else
    echo "✅ Skipping fetch/pull (already re-exec'd updated deploy-prod)"
fi

echo ""
"$SCRIPT_DIR/build-prod-image" "$COMPOSE_FILE"

echo ""
echo "🗄️  Running database migrations..."
# Uses image filesystem (vendor/ included). Do not bind-mount host source over /var/www/html.
docker compose -f "$COMPOSE_FILE" run --rm app php artisan migrate --force

echo ""
echo "🚀 Starting services (docker-compose.prod.yml only)..."
up_args=(up -d --remove-orphans)
if [[ "$PROD_LOG_ENV_CHANGED" -eq 1 ]]; then
    echo "   Recreating containers so env_file picks up LOG_CHANNEL/LOG_STACK"
    up_args+=(--force-recreate)
fi
docker compose -f "$COMPOSE_FILE" "${up_args[@]}"

# Rebuild retags lateralzr_app:prod / lateralzr_nginx:prod; after containers
# switch, the previous digests are dangling (~1.27GB each). Reclaim them
# conservatively (same script: no volume/cert/stack deletes).
run_deploy_docker_cleanup "after compose up"

echo ""
echo "⚡ Optimizing Laravel caches..."
# Cache into running containers (run --rm would discard bootstrap/cache writes).
# Run as www-data so compiled views/logs are not recreated as root:root.
docker compose -f "$COMPOSE_FILE" exec -T -u www-data app php artisan config:cache
docker compose -f "$COMPOSE_FILE" exec -T -u www-data app php artisan route:cache
docker compose -f "$COMPOSE_FILE" exec -T -u www-data app php artisan view:cache
docker compose -f "$COMPOSE_FILE" exec -T -u www-data queue php artisan config:cache
docker compose -f "$COMPOSE_FILE" exec -T -u www-data scheduler php artisan config:cache

echo ""
echo "📝 Verifying Laravel daily log..."
if [[ ! -x "$SCRIPT_DIR/verify-prod-daily-log" ]]; then
    echo "❌ bin/verify-prod-daily-log is missing or not executable" >&2
    exit 1
fi
docker compose -f "$COMPOSE_FILE" exec -T -u www-data app /var/www/html/bin/verify-prod-daily-log

echo ""
echo "📝 Verifying queue.log captures worker stdout/stderr..."
queue_ok=0
for attempt in 1 2 3 4 5 6 7 8; do
    if [[ -s "${logs_host}/queue/queue.log" ]] \
        && grep -qE 'Processing jobs|queue:work|tee-service-log' "${logs_host}/queue/queue.log"; then
        echo "✅ queue.log captured worker output"
        queue_ok=1
        break
    fi
    echo "   waiting for queue worker startup line (${attempt}/8)..."
    sleep 2
done
if [[ "$queue_ok" -ne 1 ]]; then
    echo "❌ queue.log did not capture worker stdout/stderr" >&2
    echo "   path: ${logs_host}/queue/queue.log" >&2
    wc -c "${logs_host}/queue/queue.log" >&2 || true
    tail -n 20 "${logs_host}/queue/queue.log" >&2 || true
    docker compose -f "$COMPOSE_FILE" logs --tail=40 queue >&2 || true
    exit 1
fi

echo ""
echo "✅ Deployment complete!"
echo ""
echo "📊 Service status:"
docker compose -f "$COMPOSE_FILE" ps

echo ""
echo "🔗 API endpoint: https://api.lateralzr.com"
echo ""
echo "🔍 Running health checks (will retry to allow for ACME cert issuance)..."

# Health check with retry to allow for Let's Encrypt certificate issuance
MAX_ATTEMPTS=5
RETRY_DELAY=3
attempt=1

health_ok() {
    curl -fsS --max-time 10 https://api.lateralzr.com/api/hello >/dev/null 2>&1 \
        && curl -fsS --max-time 10 https://api.lateralzr.com/up >/dev/null 2>&1 \
        && curl -fsS --max-time 10 https://api.lateralzr.com/admin/login >/dev/null 2>&1
}

while [ $attempt -le $MAX_ATTEMPTS ]; do
    echo "   Attempt $attempt/$MAX_ATTEMPTS: Testing /api/hello, /up, and /admin/login..."

    if health_ok; then
        echo "✅ Health checks passed!"
        echo ""
        echo "   API:   curl https://api.lateralzr.com/api/hello"
        echo "   Admin: curl -I https://api.lateralzr.com/admin/login"
        echo "   Logs:  docker compose -f $COMPOSE_FILE logs --tail=100 app"
        echo "          tail -n 100 ${storage_host}/logs/laravel-$(date +%Y-%m-%d).log"
        echo "          tail -n 100 ${logs_host}/nginx/access.log"
        exit 0
    fi
    
    if [ $attempt -lt $MAX_ATTEMPTS ]; then
        echo "   ⏳ Health check failed, retrying in ${RETRY_DELAY}s..."
        sleep $RETRY_DELAY
    fi
    
    attempt=$((attempt + 1))
done

echo ""
echo "⚠️  Health check failed after $MAX_ATTEMPTS attempts"
echo "   This may be normal if Let's Encrypt cert is still being issued"
echo "   Verify manually:"
echo "     curl -i https://api.lateralzr.com/api/hello"
echo "     curl -i https://api.lateralzr.com/up"
echo "     curl -i https://api.lateralzr.com/admin/login"
echo "   Logs:"
    echo "     docker compose -f $COMPOSE_FILE logs --tail=200 app"
    echo "     tail -n 200 ${storage_host}/logs/laravel-$(date +%Y-%m-%d).log"
    echo "     tail -n 200 ${logs_host}/nginx/error.log"
echo ""
exit 1
