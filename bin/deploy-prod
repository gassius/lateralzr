#!/usr/bin/env bash

set -euo pipefail

# Lateralzr Production Deployment
# Designed to run in /home/cgonzalez/lateralzr ONLY
# Never touches the gonzalezrico compose stack

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PROJECT_ROOT="$(cd "$SCRIPT_DIR/.." && pwd)"
COMPOSE_FILE="docker-compose.prod.yml"

cd "$PROJECT_ROOT"

echo "🚀 Lateralzr Production Deployment"
echo "==================================="
echo "Working directory: $(pwd)"
echo ""

if [[ ! -f "$COMPOSE_FILE" ]]; then
    echo "❌ Error: $COMPOSE_FILE not found in $(pwd)"
    exit 1
fi

if [[ ! -f .env ]]; then
    echo "❌ Error: .env file not found"
    echo "   Create .env from .env.production.example and configure it"
    exit 1
fi

APP_KEY_VALUE="$(grep -E '^APP_KEY=' .env | head -n1 | cut -d= -f2- | sed 's/#.*//' | tr -d '[:space:]' | tr -d '"' | tr -d "'")"
if [[ -z "$APP_KEY_VALUE" ]]; then
    echo "❌ Error: APP_KEY is empty in .env"
    echo "   Generate with: docker compose -f $COMPOSE_FILE run --rm app php artisan key:generate --show"
    exit 1
fi

echo "📁 Ensuring host storage directories exist..."
mkdir -p \
    storage/app/public \
    storage/app/private \
    storage/framework/cache/data \
    storage/framework/sessions \
    storage/framework/testing \
    storage/framework/views \
    storage/logs
echo ""

# shellcheck source=deploy-disk-check.sh
source "$SCRIPT_DIR/deploy-disk-check.sh"
if ! check_deploy_disk_space "$PROJECT_ROOT"; then
    exit 1
fi
echo ""

echo "🔍 Checking git status..."
if [[ -n $(git status --porcelain) ]]; then
    echo "⚠️  Warning: Working directory has uncommitted changes"
    echo ""
    git status --short
    echo ""
    echo "❌ Refusing to deploy with dirty working tree"
    echo "   Commit or stash changes before deploying"
    exit 1
fi

CURRENT_BRANCH=$(git rev-parse --abbrev-ref HEAD)
echo "📍 Current branch: $CURRENT_BRANCH"

echo "🔄 Fetching latest from origin..."
git fetch origin "$CURRENT_BRANCH"

LOCAL_REV=$(git rev-parse HEAD)
REMOTE_REV=$(git rev-parse "origin/$CURRENT_BRANCH")

if [[ "$LOCAL_REV" != "$REMOTE_REV" ]]; then
    echo "⬇️  Pulling latest changes..."
    git pull origin "$CURRENT_BRANCH"
else
    echo "✅ Already up to date with origin/$CURRENT_BRANCH"
fi

echo ""
"$SCRIPT_DIR/build-prod-image" "$COMPOSE_FILE"

echo ""
echo "🗄️  Running database migrations..."
# Uses image filesystem (vendor/ included). Do not bind-mount host source over /var/www/html.
docker compose -f "$COMPOSE_FILE" run --rm app php artisan migrate --force

echo ""
echo "🚀 Starting services (docker-compose.prod.yml only)..."
docker compose -f "$COMPOSE_FILE" up -d --remove-orphans

echo ""
echo "⚡ Optimizing Laravel caches..."
# Cache into running containers (run --rm would discard bootstrap/cache writes).
# Run as www-data so compiled views/logs are not recreated as root:root.
docker compose -f "$COMPOSE_FILE" exec -T -u www-data app php artisan config:cache
docker compose -f "$COMPOSE_FILE" exec -T -u www-data app php artisan route:cache
docker compose -f "$COMPOSE_FILE" exec -T -u www-data app php artisan view:cache
docker compose -f "$COMPOSE_FILE" exec -T -u www-data queue php artisan config:cache
docker compose -f "$COMPOSE_FILE" exec -T -u www-data scheduler php artisan config:cache

echo ""
echo "✅ Deployment complete!"
echo ""
echo "📊 Service status:"
docker compose -f "$COMPOSE_FILE" ps

echo ""
echo "🔗 API endpoint: https://api.lateralzr.com"
echo ""
echo "🔍 Running health checks (will retry to allow for ACME cert issuance)..."

# Health check with retry to allow for Let's Encrypt certificate issuance
MAX_ATTEMPTS=5
RETRY_DELAY=3
attempt=1

health_ok() {
    curl -fsS --max-time 10 https://api.lateralzr.com/api/hello >/dev/null 2>&1 \
        && curl -fsS --max-time 10 https://api.lateralzr.com/up >/dev/null 2>&1 \
        && curl -fsS --max-time 10 https://api.lateralzr.com/admin/login >/dev/null 2>&1
}

while [ $attempt -le $MAX_ATTEMPTS ]; do
    echo "   Attempt $attempt/$MAX_ATTEMPTS: Testing /api/hello, /up, and /admin/login..."

    if health_ok; then
        echo "✅ Health checks passed!"
        echo ""
        echo "   API:   curl https://api.lateralzr.com/api/hello"
        echo "   Admin: curl -I https://api.lateralzr.com/admin/login"
        echo "   Logs:  docker compose -f $COMPOSE_FILE logs --tail=100 app"
        echo "          tail -n 100 storage/logs/laravel.log"
        exit 0
    fi
    
    if [ $attempt -lt $MAX_ATTEMPTS ]; then
        echo "   ⏳ Health check failed, retrying in ${RETRY_DELAY}s..."
        sleep $RETRY_DELAY
    fi
    
    attempt=$((attempt + 1))
done

echo ""
echo "⚠️  Health check failed after $MAX_ATTEMPTS attempts"
echo "   This may be normal if Let's Encrypt cert is still being issued"
echo "   Verify manually:"
echo "     curl -i https://api.lateralzr.com/api/hello"
echo "     curl -i https://api.lateralzr.com/up"
echo "     curl -i https://api.lateralzr.com/admin/login"
echo "   Logs:"
echo "     docker compose -f $COMPOSE_FILE logs --tail=200 app"
echo "     tail -n 200 storage/logs/laravel.log"
echo ""
exit 1
