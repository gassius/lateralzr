#!/usr/bin/env python3
"""Strict-parse YAML files so invalid workflow/compose YAML fails CI.

Parses every changed *.yml / *.yaml in the repo, and always includes
.github/workflows/* and docker-compose*.yml (plus compose.yaml).
Fails on the first parser error after reporting all failures.
"""

from __future__ import annotations

import os
import subprocess
import sys
from pathlib import Path

try:
    import yaml
except ImportError:
    sys.stderr.write("PyYAML is required (pip install pyyaml)\n")
    sys.exit(1)

ROOT = Path(__file__).resolve().parent.parent
SKIP_DIR_PARTS = {".git", "node_modules", "vendor", ".turbo"}
ALWAYS_GLOBS = (
    ".github/workflows/*.yml",
    ".github/workflows/*.yaml",
    "docker-compose*.yml",
    "docker-compose*.yaml",
    "compose.yml",
    "compose.yaml",
)


def is_yaml_path(path: str) -> bool:
    return path.endswith((".yml", ".yaml"))


def should_skip(path: Path) -> bool:
    return any(part in SKIP_DIR_PARTS for part in path.parts)


def run_git(args: list[str]) -> subprocess.CompletedProcess[str]:
    return subprocess.run(args, cwd=ROOT, capture_output=True, text=True, check=False)


def tracked_yaml() -> list[str]:
    result = run_git(["git", "ls-files", "*.yml", "*.yaml"])
    return [line for line in result.stdout.splitlines() if is_yaml_path(line)]


def changed_yaml() -> list[str]:
    event = os.environ.get("GITHUB_EVENT_NAME", "")
    if event == "pull_request":
        base = os.environ.get("GITHUB_BASE_REF") or "main"
        # Do not pass --depth: checkout uses fetch-depth: 0, and a shallow
        # fetch would mark the repo shallow and break origin/base...HEAD.
        run_git(["git", "fetch", "origin", base])
        result = run_git(
            ["git", "diff", "--name-only", "--diff-filter=ACMR", f"origin/{base}...HEAD"]
        )
    else:
        before = os.environ.get("GITHUB_EVENT_BEFORE") or ""
        if before and set(before) != {"0"}:
            result = run_git(
                ["git", "diff", "--name-only", "--diff-filter=ACMR", f"{before}...HEAD"]
            )
        else:
            result = run_git(["git", "ls-files", "*.yml", "*.yaml"])
    if result.returncode != 0:
        result = run_git(["git", "ls-files", "*.yml", "*.yaml"])
    return [line for line in result.stdout.splitlines() if is_yaml_path(line)]


def always_files() -> list[str]:
    files: list[str] = []
    for pattern in ALWAYS_GLOBS:
        files.extend(str(path.relative_to(ROOT)) for path in ROOT.glob(pattern) if path.is_file())
    return files


def main() -> int:
    candidates = sorted(set(changed_yaml() + always_files()))
    if not candidates:
        print("No YAML files to parse")
        return 0

    failed = 0
    parsed = 0
    for rel in candidates:
        path = ROOT / rel
        if should_skip(path) or not path.is_file():
            continue
        try:
            yaml.safe_load(path.read_text(encoding="utf-8"))
        except Exception as exc:  # noqa: BLE001 — report every file, then fail
            print(f"ERROR {rel}: {exc}", file=sys.stderr)
            failed += 1
        else:
            print(f"OK {rel}")
            parsed += 1

    if failed:
        print(f"Failed to parse {failed} YAML file(s)", file=sys.stderr)
        return 1
    print(f"Parsed {parsed} YAML file(s)")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
