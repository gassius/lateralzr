#!/usr/bin/env bash

# Resolve the prod file-log host root: ${LATERALZR_STORAGE}/logs
# (same tree as Laravel daily files). Service dirs are
# <this>/nginx, <this>/queue, <this>/scheduler.
#
#   ./storage          → ./storage/logs
#   /mnt/data/lateralzr/storage → /mnt/data/lateralzr/storage/logs
#
# Usage:
#   bin/logs-host                 # print the resolved path
#   bin/logs-host --require-ready # also fail-fast for a non-default storage path

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

if [[ ! -x "$SCRIPT_DIR/storage-host" ]]; then
    echo "❌ bin/storage-host is missing or not executable" >&2
    exit 1
fi

storage_host="$("$SCRIPT_DIR/storage-host" "$@")"
printf '%s/logs\n' "$storage_host"
